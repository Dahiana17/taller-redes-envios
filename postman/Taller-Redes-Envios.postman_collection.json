{
  "info": {
    "name": "Taller Final - Programación de Redes (API de Envíos)",
    "_postman_id": "8f6b2a10-3c1e-4d7a-9b55-0c1af0e2d501",
    "description": "Colección del taller final: endpoints GET/POST /api/envios, validación del header X-Red-Equipo (CIAF-N), header de respuesta X-Servidor-Procesado (Equipo-N) y política CORS.\n\nEquipo: Marin Giraldo Dahiana (15) y Moncada Castro Angel Stewar (16) - Grupo 1. N = 15, header X-Red-Equipo: CIAF-15.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipo", "value": "CIAF-15" },
    { "key": "origenPermitido", "value": "http://localhost:5500" },
    { "key": "guiaCreada", "value": "" }
  ],
  "item": [
    {
      "name": "1. Válidas (200 / 201)",
      "item": [
        {
          "name": "GET listar envíos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve X-Servidor-Procesado: Equipo-N', () => {",
                  "  const n = pm.collectionVariables.get('equipo').replace('CIAF-', '');",
                  "  pm.expect(pm.response.headers.get('X-Servidor-Procesado')).to.eql('Equipo-' + n);",
                  "});",
                  "pm.test('Respuesta JSON con lista de envíos', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.envios).to.be.an('array');",
                  "  pm.expect(body.total).to.eql(body.envios.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Red-Equipo", "value": "{{equipo}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "POST registrar envío (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve header Location y X-Servidor-Procesado', () => {",
                  "  pm.response.to.have.header('Location');",
                  "  pm.response.to.have.header('X-Servidor-Procesado');",
                  "});",
                  "pm.test('El envío queda en estado REGISTRADO', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.envio.estado).to.eql('REGISTRADO');",
                  "  pm.collectionVariables.set('guiaCreada', body.envio.guia);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Red-Equipo", "value": "{{equipo}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remitente\": \"Papelería La 18\",\n  \"destinatario\": \"Juan Pérez\",\n  \"ciudadOrigen\": \"Pereira\",\n  \"ciudadDestino\": \"Bogotá\",\n  \"pesoKg\": 3.2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "GET consultar envío por guía (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve la guía consultada', () => {",
                  "  const esperada = pm.collectionVariables.get('guiaCreada') || 'ENV-1001';",
                  "  pm.expect(pm.response.json().guia).to.eql(esperada);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('guiaCreada')) { pm.collectionVariables.set('guiaCreada', 'ENV-1001'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Red-Equipo", "value": "{{equipo}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/envios/{{guiaCreada}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios", "{{guiaCreada}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Fallidas (401 / 400)",
      "item": [
        {
          "name": "GET sin header X-Red-Equipo (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('JSON explicativo', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('Unauthorized');",
                  "  pm.expect(body.mensaje).to.include('X-Red-Equipo');",
                  "});",
                  "pm.test('NO trae X-Servidor-Procesado (no es respuesta exitosa)', () => {",
                  "  pm.response.to.not.have.header('X-Servidor-Procesado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "GET con header incorrecto (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Informa el valor recibido', () => {",
                  "  pm.expect(pm.response.json().valor_recibido).to.eql('CIAF-999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Red-Equipo", "value": "CIAF-999" }],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "POST con datos incompletos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Indica los campos faltantes', () => {",
                  "  pm.expect(pm.response.json().campos_faltantes).to.include.members(['ciudadDestino', 'pesoKg']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Red-Equipo", "value": "{{equipo}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remitente\": \"Papelería La 18\",\n  \"destinatario\": \"Juan Pérez\",\n  \"ciudadOrigen\": \"Pereira\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Verificación de encabezados (CORS)",
      "item": [
        {
          "name": "GET desde origen permitido - revisar headers de respuesta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Access-Control-Allow-Origin = origen permitido', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('origenPermitido'));",
                  "});",
                  "pm.test('Expone X-Servidor-Procesado al navegador', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Expose-Headers')).to.include('X-Servidor-Procesado');",
                  "});",
                  "pm.test('Content-Type JSON', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "pm.test('No revela X-Powered-By', () => pm.response.to.not.have.header('X-Powered-By'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Red-Equipo", "value": "{{equipo}}" },
              { "key": "Origin", "value": "{{origenPermitido}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "OPTIONS preflight desde origen permitido (204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Permite el origen y el header X-Red-Equipo', () => {",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('origenPermitido'));",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Headers')).to.include('X-Red-Equipo');",
                  "  pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              { "key": "Origin", "value": "{{origenPermitido}}" },
              { "key": "Access-Control-Request-Method", "value": "POST" },
              { "key": "Access-Control-Request-Headers", "value": "content-type,x-red-equipo" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        },
        {
          "name": "GET desde origen NO permitido - sin Access-Control-Allow-Origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El servidor NO devuelve Access-Control-Allow-Origin', () => {",
                  "  pm.response.to.not.have.header('Access-Control-Allow-Origin');",
                  "});",
                  "pm.test('Vary: Origin presente', () => {",
                  "  pm.expect(pm.response.headers.get('Vary')).to.include('Origin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "description": "Postman no aplica CORS (no es un navegador), por eso SÍ ve la respuesta. Lo importante es que el servidor no envía Access-Control-Allow-Origin, así que un navegador en http://sitio-malicioso.com bloquearía la lectura.",
            "method": "GET",
            "header": [
              { "key": "X-Red-Equipo", "value": "{{equipo}}" },
              { "key": "Origin", "value": "http://sitio-malicioso.com" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/envios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "envios"]
            }
          }
        }
      ]
    }
  ]
}
